# ===== 数据库（可选，默认自动回退到本地文件/内存后端） =====
# 本地 docker 容器：docker compose up -d（未启动则自动跳过 DB 存储）
DATABASE_URL=postgresql://analysisdaily:analysisdaily@localhost:5433/analysisdaily

# ===== 数据源（都是可选，缺省时仅用公开 RSS / 样本夹具） =====
GROUND_NEWS_API_KEY=
ALLSIDES_API_KEY=
# Reuters / AP 官方/授权接口（需授权，缺省时用公开 RSS 通道）
WIRE_EARTH_API_KEY=

# ===== LLM 事实引擎（可选，不填则走确定性规则引擎） =====
LLM_PROVIDER=openai      # openai | anthropic | none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60

# ===== Embedding（可选，缺省用 TF-IDF 确定性向量） =====
EMBEDDING_BACKEND=auto   # auto | sentence_transformers | tfidf | hashing
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 分发（可选，缺省仅本地落盘） =====
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ===== 运行 =====
CLUSTER_WINDOW_HOURS=24
CLUSTER_MIN_SAMPLES=2
APP_DATA_DIR=./data